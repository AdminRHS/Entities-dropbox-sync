      "id": "PLM-047",
      "name": "Task File Pattern",
      "placement": "TASKS/TASK-###_{Name}.md",
      "description": "Standard task file naming pattern",
      "type": "pattern",
      "id_format": "TASK-###",
      "naming_rules": {
        "id": "TASK-### (3 digits, zero-padded, sequential)",
        "separator": "_ (underscore after ID)",
        "name": "Descriptive name with underscores (not spaces)",
        "extension": ".md (markdown)"
      },
      "template_sections": [
        "Task Description",
        "Context",
        "Objectives",
        "Deliverables",
        "Implementation Plan",
        "Success Criteria",
        "Clarifications Needed",
        "Next Steps"
      ]
    },
    {
      "id": "PLM-048",
      "name": "Execution File Pattern",
      "placement": "AI_EXECUTIONS/EXC-###_{Name}.md",
      "description": "Standard execution file naming pattern",
      "type": "pattern",
      "id_format": "EXC-###",
      "naming_rules": {
        "id": "EXC-### (3 digits, zero-padded, sequential)",
        "separator": "_ (underscore after ID)",
        "name": "Descriptive name with underscores",
        "extension": ".md (markdown)"
      },
      "template_sections": [
        "Input",
        "Process",
        "Output",
        "Validation",
        "Next Executions"
      ]
    },
    {
      "id": "PLM-049",
      "name": "Task Archive Pattern",
      "placement": "TASKS/_Archive/TASK-###_{Name}.md",
      "description": "Archived completed tasks",
      "type": "pattern",
      "usage": "Move completed tasks to archive folder",
      "examples": [
        "TASKS/_Archive/TASK-001_AI_Voice_Agent.md"
      ]
    }
