  "report_placements": [
    {
      "id": "PLM-023",
      "name": "Reports Root",
      "placement": "Reports/",
      "description": "Root placement for all reports",
      "type": "folder",
      "structure": {
        "Daily/": "Daily session reports",
        "Weekly/": "Weekly summaries",
        "Monthly/": "Monthly reviews"
      }
    },
    {
      "id": "PLM-024",
      "name": "Reports Daily",
      "placement": "Reports/Daily/",
      "description": "Daily session reports and summaries",
      "type": "folder",
      "file_pattern": "YYYY-MM-DD_{description}.md",
      "examples": [
        "2025-12-08_session_1_report.md",
        "2025-12-08_systems_created_summary.md",
        "2025-12-08_integration_summary.md"
      ]
    },
    {
      "id": "PLM-025",
      "name": "Execution Chat Log",
      "placement": "Execution/chat_log.md",
      "description": "Running log of all session conversations",
      "type": "file",
      "purpose": "Track all sessions chronologically",
      "format": "Chronological entries with timestamps",
      "importance": "critical"
    },
    {
      "id": "PLM-034",
      "name": "Session Handoff",
      "placement": "SESSION_HANDOFF.md",
      "description": "Bridge between sessions with priorities",
      "type": "file",
      "purpose": "Next session knows what to do immediately",
      "sections": [
        "Context Summary",
        "Immediate Priorities",
        "High Priority Items",
        "Medium Priority Items",
        "Clarifications Pending",
        "Files to Load",
        "Ready Executions"
      ],
      "importance": "critical",
      "updated": "End of every session"
    },
    {
      "id": "PLM-046",
      "name": "Daily Report Pattern",
      "placement": "Reports/Daily/YYYY-MM-DD_{description}.md",
      "description": "Standard daily report naming pattern",
      "type": "pattern",
      "date_format": "YYYY-MM-DD (ISO 8601)",
      "naming_rules": {
        "date": "YYYY-MM-DD",
        "separator": "_",
        "description": "Brief description (session_1_report, systems_created_summary)",
        "extension": ".md"
      },
      "common_descriptions": [
        "session_{N}_report",
        "systems_created_summary",
        "integration_summary",
        "progress_summary",
        "tasks_created",
        "executions_completed"
      ]
    },
    {
      "id": "PLM-050",
      "name": "Day Summary",
      "placement": "Week_01/{day}/output/{day}_wspr_FINAL_SUMMARY.md",
      "description": "Final summary for each day's work",
      "type": "pattern",
      "purpose": "Comprehensive day overview",
      "examples": [
        "Week_01/06/output/06_wspr_FINAL_SUMMARY.md",
        "Week_01/07/output/07_wspr_FINAL_SUMMARY.md"
      ],
      "importance": "high"
    },
    {
      "id": "PLM-051",
      "name": "Session Execution Summary",
      "placement": "Week_01/{day}/output/SESSION_EXECUTION_SUMMARY.md",
      "description": "Execution status for day's work",
      "type": "pattern",
      "purpose": "Track what was executed vs planned",
      "examples": [
        "Week_01/07/output/SESSION_EXECUTION_SUMMARY.md"
      ]
    },
    {
      "id": "PLM-052",
      "name": "Day Index",
      "placement": "Week_01/{day}/output/INDEX.md",
      "description": "Complete file listing for day",
      "type": "pattern",
      "purpose": "Navigate all day outputs",
      "examples": [
        "Week_01/07/output/INDEX.md"
      ]
    }
