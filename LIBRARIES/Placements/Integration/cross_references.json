        "System/Libraries/TERMINOLOGY_STANDARDS.md"
      ]
    },
    "entities_hierarchy": {
      "root": "ENTITIES/",
      "level_1": [
        "ENTITIES/Libraries/",
        "ENTITIES/Actions/",
        "ENTITIES/Similar/",
        "ENTITIES/Scraping/",
        "ENTITIES/Video/",
        "ENTITIES/HR/",
        "ENTITIES/Executives/",
        "ENTITIES/PROMPTS/"
      ],
      "level_2_libraries": [
        "ENTITIES/Libraries/Placements/",
        "ENTITIES/Libraries/Responsibilities/"
      ],
      "level_3_library_structure": [
        "ENTITIES/Libraries/{library}/Core/",
        "ENTITIES/Libraries/{library}/By_Type/",
        "ENTITIES/Libraries/{library}/Integration/",
        "ENTITIES/Libraries/{library}/Symbols/",
        "ENTITIES/Libraries/{library}/Templates/"
      ]
    },
    "work_hierarchy": {
      "tracking": [
        "TASKS/",
        "AI_EXECUTIONS/",
        "CLARIFICATIONS/",
        "USER_INPUTS/"
      ],
      "reporting": [
        "Reports/Daily/",
        "Reports/Weekly/",
        "Execution/chat_log.md",
        "SESSION_HANDOFF.md"
      ],
      "daily_work": [
        "Week_01/{day}/",
        "Week_01/{day}/output/",
        "Week_01/{day}/guides/"
      ]
    }
  },
  "dependency_graph": {
    "session_handoff_dependencies": {
      "placement": "SESSION_HANDOFF.md",
      "reads_from": [
        "TASKS/",
        "AI_EXECUTIONS/",
        "CLARIFICATIONS/README.md",
        "Reports/Daily/",
        "Execution/chat_log.md"
      ],
      "used_by": [
        "Next session (Phase 1: Open)"
      ]
    },
    "task_dependencies": {
      "placement": "TASKS/TASK-###_{Name}.md",
      "reads_from": [
        "ENTITIES/ (entity data)",
        "System/ (system resources)",
        "CLARIFICATIONS/README.md (questions)"
      ],
      "writes_to": [
        "Week_01/{day}/output/ (task outputs)",
        "Reports/Daily/ (progress reports)"
      ],
      "blocks": [
        "CLARIFICATIONS/README.md (pending questions block task)"
      ]
    },
    "execution_dependencies": {
      "placement": "AI_EXECUTIONS/EXC-###_{Name}.md",
      "reads_from": [
        "TASKS/ (parent task context)",
        "ENTITIES/ (entity data)",
        "System/ (system specs)"
      ],
      "writes_to": [
        "Varied outputs based on execution type"
      ]
    },
    "clarifications_dependencies": {
      "placement": "CLARIFICATIONS/README.md",
      "reads_from": [
        "TASKS/ (task requirements)"
      ],
      "used_by": [
        "TASKS/ (blocks until answered)",
        "USER_INPUTS/ (user provides answers)",
        "SESSION_HANDOFF.md (tracks pending)"
      ]
    }
  },
  "file_relationships": {
    "entrance_points": [
      {
        "placement": "Week_01/{day}/README.md",
        "purpose": "Day entrance point",
        "references": [
          "{day}/output/INDEX.md",
          "{day}/output/{day}_wspr_FINAL_SUMMARY.md",
          "{day}/output/SESSION_EXECUTION_SUMMARY.md",
          "{day}/guides/HOW_TO_NAVIGATE.md"
        ]
      },
      {
        "placement": "SESSION_HANDOFF.md",
        "purpose": "Session entrance point",
        "references": [
          "TASKS/",
          "AI_EXECUTIONS/",
          "CLARIFICATIONS/README.md",
          "Execution/chat_log.md"
        ]
      },
      {
        "placement": "ENTITIES/Libraries/{library}/README.md",
        "purpose": "Library entrance point",
        "references": [
          "Core/",
          "By_Type/",
          "Integration/",
          "Symbols/",
          "Templates/"
        ]
      }
    ],
    "index_files": [
      {
        "placement": "Week_01/{day}/output/INDEX.md",
        "purpose": "Complete file listing for day",
        "lists_placements_in": "Week_01/{day}/"
      }
    ],
    "summary_files": [
      {
        "placement": "Week_01/{day}/output/{day}_wspr_FINAL_SUMMARY.md",
        "purpose": "Day summary",
        "references_placements": "All significant placements from that day"
      }
    ]
  },
