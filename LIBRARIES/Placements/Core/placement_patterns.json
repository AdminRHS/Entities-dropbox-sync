      "patterns": ["PAT-018"]
    }
  },
  "usage_rules": {
    "consistency": "Always follow established patterns for similar files",
    "dates": "Always use ISO 8601 format (YYYY-MM-DD) for dates",
    "ids": "Always use zero-padded numbers for IDs (001, not 1)",
    "separators": "Use underscores for multi-word names (not spaces or dashes)",
    "extensions": "Use .md for documentation, .json for data, .py for scripts"
  },
  "integration": {
    "reserved_words": {
      "CREATE": "Use when creating new files following patterns",
      "PLACEMENT": "Use when specifying where files go",
      "BUILD": "Use when constructing folder structures"
    },
    "terminology_standards": "All patterns comply with System/Libraries/TERMINOLOGY_STANDARDS.md",
